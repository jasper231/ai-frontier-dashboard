{
  "name": "ai-frontier-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "python3 -m http.server 3000 --bind 0.0.0.0 --directory out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview:static": "python3 -m http.server 3000 --bind 0.0.0.0 --directory static-preview",
    "generate:static": "node scripts/create-static.mjs",
    "test:data": "node tests/news.test.cjs",
    "news:refresh": "node scripts/refresh-news.cjs --live",
    "news:fixtures": "node scripts/refresh-news.cjs --fixtures",
    "test:feeds": "node tests/feeds.test.cjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "node tests/pages.test.cjs && node tests/preferences.test.cjs && node tests/live-verification.test.cjs",
    "test:ai": "node tests/intelligence.test.cjs",
    "news:mock": "node scripts/refresh-news.cjs --fixtures --ai-mock",
    "test:quality": "node tests/quality.test.cjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0"
  }
}
