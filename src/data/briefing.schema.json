{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasper231.github.io/ai-frontier-dashboard/schemas/briefing.schema.json",
  "title": "Evidence-linked bilingual AI & Frontier Briefing edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "timeZone",
    "date",
    "generatedAt",
    "sourceSnapshotAt",
    "provenance",
    "sources",
    "executiveOpening",
    "stories",
    "watchNext",
    "keyword"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "status": {
      "const": "published"
    },
    "timeZone": {
      "const": "Asia/Shanghai"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sourceSnapshotAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "author",
        "evidenceReviewed",
        "bilingualReviewed"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "evidenceReviewed": {
          "const": true
        },
        "bilingualReviewed": {
          "const": true
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "executiveOpening": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/narrative"
          },
          {
            "properties": {
              "kind": {
                "const": "analysis"
              }
            }
          }
        ]
      },
      "maxItems": 4
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/story"
      }
    },
    "watchNext": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/narrative"
          },
          {
            "properties": {
              "kind": {
                "const": "hypothesis"
              }
            }
          }
        ]
      },
      "maxItems": 5
    },
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "explanation",
        "whyNow"
      ],
      "properties": {
        "term": {
          "$ref": "#/$defs/bilingual"
        },
        "explanation": {
          "allOf": [
            {
              "$ref": "#/$defs/narrative"
            },
            {
              "properties": {
                "kind": {
                  "const": "analysis"
                }
              }
            }
          ]
        },
        "whyNow": {
          "allOf": [
            {
              "$ref": "#/$defs/narrative"
            },
            {
              "properties": {
                "kind": {
                  "const": "analysis"
                }
              }
            }
          ]
        }
      }
    },
    "framework": {
      "allOf": [
        {
          "$ref": "#/$defs/narrative"
        },
        {
          "properties": {
            "kind": {
              "const": "analysis"
            }
          }
        }
      ]
    },
    "coverageWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceIds",
        "kind"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/bilingual"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kind": {
          "enum": [
            "confirmed",
            "analysis",
            "hypothesis"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "name",
        "url",
        "type",
        "publisher",
        "publishedAt",
        "excerpt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "pattern": "Z$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "type": {
          "enum": [
            "official",
            "news",
            "research"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "snapshot",
            "agent-enrichment"
          ]
        },
        "adapterId": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "category",
        "title",
        "newsIds",
        "verifiedFacts",
        "sources",
        "plainExplanation",
        "whyItMatters",
        "longTermView",
        "opportunities",
        "risks",
        "keywords",
        "relatedStoryIds",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "enum": [
            "ai",
            "agents",
            "chips",
            "robotics",
            "crypto"
          ]
        },
        "title": {
          "$ref": "#/$defs/bilingual"
        },
        "newsIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "verifiedFacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/narrative"
              },
              {
                "properties": {
                  "kind": {
                    "const": "confirmed"
                  }
                }
              }
            ]
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "plainExplanation": {
          "allOf": [
            {
              "$ref": "#/$defs/narrative"
            },
            {
              "properties": {
                "kind": {
                  "const": "analysis"
                }
              }
            }
          ]
        },
        "example": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/narrative"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "hypothesis"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "whyItMatters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/narrative"
              },
              {
                "properties": {
                  "kind": {
                    "const": "analysis"
                  }
                }
              }
            ]
          }
        },
        "longTermView": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/narrative"
              },
              {
                "properties": {
                  "kind": {
                    "const": "hypothesis"
                  }
                }
              }
            ]
          }
        },
        "opportunities": {
          "type": "array",
          "minItems": 0,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/narrative"
              },
              {
                "properties": {
                  "kind": {
                    "const": "hypothesis"
                  }
                }
              }
            ]
          }
        },
        "risks": {
          "type": "array",
          "minItems": 0,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/narrative"
              },
              {
                "properties": {
                  "kind": {
                    "const": "hypothesis"
                  }
                }
              }
            ]
          }
        },
        "keywords": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "explanation"
            ],
            "properties": {
              "term": {
                "$ref": "#/$defs/bilingual"
              },
              "explanation": {
                "$ref": "#/$defs/bilingual"
              }
            }
          }
        },
        "relatedStoryIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "independentlyConfirmed"
          ],
          "properties": {
            "independentlyConfirmed": {
              "type": "boolean"
            }
          }
        },
        "crossAnalysis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/narrative"
              },
              {
                "properties": {
                  "kind": {
                    "const": "analysis"
                  }
                }
              }
            ]
          }
        },
        "internalRanking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "importance",
            "sourceQuality",
            "longTermImportance"
          ],
          "properties": {
            "importance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sourceQuality": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "longTermImportance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "keyTakeaway": {
          "allOf": [
            {
              "$ref": "#/$defs/narrative"
            },
            {
              "properties": {
                "kind": {
                  "const": "analysis"
                }
              }
            }
          ]
        }
      }
    }
  }
}
